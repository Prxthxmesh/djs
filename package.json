{
  "name": "distributed-job-scheduler",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Durable distributed job scheduler with PostgreSQL sharding",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "npm --prefix web install --no-audit --no-fund && npm --prefix web run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm --prefix web run typecheck",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "node dist/migrate.js",
    "dev:api": "tsx src/services/api-main.ts",
    "dev:worker": "tsx src/services/worker-main.ts",
    "dev:scheduler": "tsx src/services/scheduler-main.ts",
    "loadgen": "tsx src/tools/loadgen.ts",
    "benchmark": "tsx src/tools/loadgen.ts",
    "benchmark:capture": "tsx src/tools/benchmark.ts",
    "chaos": "tsx src/tools/chaos.ts",
    "chaos:smoke": "tsx src/tools/chaos.ts --smoke",
    "retention": "tsx src/tools/retention.ts"
  },
  "dependencies": {
    "@fastify/static": "7.0.4",
    "cron-parser": "^5.3.1",
    "fastify": "4.28.1",
    "pg": "8.13.1",
    "prom-client": "15.1.3",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.16.0",
    "globals": "15.13.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.17.0",
    "vitest": "2.1.8"
  }
}
